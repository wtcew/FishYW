# FishCloud 环境配置示例
# 用法：复制本文件为 .env 并按需填写。.env 已被 .gitignore 排除，切勿提交。
# 所有键留空时走代码内置默认值；带密钥的配置只应存在于本地 .env 或系统环境变量。

# ── 大模型凭据（AI 研判 / 智能问答 / 知识实体抽取共用）─────────────────
# GLM（智谱）：注册即得免费档，推荐零成本起步 —— https://open.bigmodel.cn
GLM_API_KEY=
GLM_MODEL_NAME=glm-4.7-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DeepSeek（可选；配置后优先于 GLM）—— https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 检索模型与缓存 ───────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# 模型缓存目录（bge-m3 + bge-reranker 约 4.4GB；建议指向空间充足的磁盘）
HF_HOME=D:\hf-cache

# ── 平台安全 ─────────────────────────────────────────────────────────
# JWT 签名密钥（≥32 字符随机串；留空则每次启动生成临时密钥，重启后登录态失效）
JWT_SECRET=
# 首次启动创建的管理员口令（留空走内置默认；生产部署务必显式设置强口令）
PLATFORM_ADMIN_PASSWORD=
# 告警 webhook 令牌，格式 source:token，多个用逗号分隔（如 zabbix:xxx,grafana:yyy）
WEBHOOK_TOKENS=
# 自助注册开关（开启后新账号为只读角色；默认需管理员在系统管理里启用）
PLATFORM_ALLOW_REGISTRATION=true
PLATFORM_REGISTRATION_AUTO_ACTIVE=false

# ── 数据库（MySQL 优先；未配置或连接失败时自动回落 SQLite，无需任何数据库即可运行）──
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
# SQLite 兜底库路径（留空使用内置默认）
PLATFORM_DB=

# ── 研判行为 ─────────────────────────────────────────────────────────
# AI 研判超时秒数（免费档模型较慢，建议给足余量）
DIAGNOSIS_TIMEOUT_SECONDS=240
# 命中"自动研判"规则时是否执行研判
AUTO_DIAGNOSIS_ENABLED=true
